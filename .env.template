# A2A demo — configuration template
#
# Copy this file to python/.env to configure the Python host and client.
# The .NET side reads the same settings from appsettings.Development.json instead —
# see the README for the equivalent file. Both are gitignored.
#
#     cp .env.template python/.env
#
# Everything below is OPTIONAL. With no configuration at all, both hosts fall back
# to a scripted offline agent and every demo except `delegate` still runs.

# ── Azure OpenAI ────────────────────────────────────────────────────────────────
# Puts a real model behind the agent instead of the offline stub.
#
# Endpoint accepts either style; the "/openai/v1" suffix is appended if missing:
#   Azure AI Foundry     https://<resource>.services.ai.azure.com/openai/v1
#   Azure OpenAI classic https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# ── Python host (a2a_host.py) ───────────────────────────────────────────────────
# Where the Python A2A agent listens. Keep it off 5401 so it can run alongside
# the .NET host.
A2A_HOST=127.0.0.1
A2A_PORT=5402

# Seconds of padding per step in the long-running job, so the Task lifecycle is
# visible on stage. Four steps, so 3.0 gives a ~12 second job.
DEMO_LONG_RUNNING_STEP_SECONDS=3.0

# ── Python client (a2a_console.py) ──────────────────────────────────────────────
# Which agent to call. Point it at the .NET host on 5401 or the Python host on 5402.
A2A_BASE_URL=http://localhost:5401
A2A_CARD_PATH=/.well-known/agent-card.json
